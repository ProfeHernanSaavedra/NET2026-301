<UserControl x:Class="Presentacion.Forms.UcTarea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25">
        <StackPanel Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Nueva tarea" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Título (máximo 50 caracteres)"/>
            <TextBox x:Name="TxtTitulo" MaxLength="50" Margin="0,4,0,12"/>
            <TextBlock Text="Descripción (máximo 50 caracteres)"/>
            <TextBox x:Name="TxtCuerpo" MaxLength="50" Margin="0,4,0,12"/>
            <TextBlock Text="Categoría"/>
            <ComboBox x:Name="CmbCategoria" DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,4,0,12"/>
            <TextBlock Text="Fecha de vencimiento (opcional)"/>
            <DatePicker x:Name="DtpVencimiento" Margin="0,4,0,18"/>
            <Button Content="Guardar tarea" Width="130" HorizontalAlignment="Right" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
